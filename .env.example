APP_NAME="WBIMIS USTP Balubal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production behind HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue: "database" lets the 5-minute cron worker drain non-urgent emails and
# push notifications on shared hosting (no long-running worker needed).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail.
# LOCAL: MAIL_MAILER=log writes email to the log file.
# PRODUCTION (Namecheap): queued module emails (service requests, bookings,
# job orders, liabilities) are Laravel Mailables and must use Brevo SMTP:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=<Brevo SMTP login>
#   MAIL_PASSWORD=<Brevo SMTP key>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Synchronous auth emails (registration OTP, password reset) are sent via the
# Brevo HTTP API — they are NOT queued, so they must be configured or users
# cannot register or reset their password.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="${APP_NAME}"
STUDENT_VERIFICATION_OCR=true
STUDENT_VERIFICATION_OCR_BINARY=tesseract
STUDENT_VERIFICATION_PDF_BINARY=pdftoppm
STUDENT_VERIFICATION_RETENTION_DAYS=730
STUDENT_VERIFICATION_ACADEMIC_YEAR=
STUDENT_VERIFICATION_SEMESTER=
# Set STUDENT_VERIFICATION_PHP_BINARY to the CLI PHP path on PHP-FPM hosting.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
